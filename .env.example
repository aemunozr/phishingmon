# =============================================================================
#  CONFIGURACION DE phishing-msg-collector
# =============================================================================
#  1) Copia este archivo y renombralo como  .env      ->  cp .env.example .env
#  2) Rellena los valores. NO compartas el .env: contiene secretos.
#  3) Permisos recomendados en Linux:                 ->  chmod 600 .env
#
#  Esta herramienta es SOLO LECTURA: nunca modifica el buzon.
# =============================================================================


# =========================================================
# MICROSOFT GRAPH
# =========================================================
# Datos de la aplicacion registrada en Microsoft Entra ID (Azure AD).
# Permiso de aplicacion requerido: Mail.Read (con Admin Consent).
# NO usar Mail.ReadWrite.

TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
MAILBOX=phishing@itau.cl


# =========================================================
# CONSULTA
# =========================================================
# FIRST_RUN_HOURS: en la PRIMERA ejecucion (sin historial) se revisan
#                  las ultimas N horas.
# LOOKBACK_MINUTES: margen hacia atras que se resta a la ultima revision
#                   exitosa, para no perder correos si una corrida se atrasa.

FIRST_RUN_HOURS=24
LOOKBACK_MINUTES=10


# =========================================================
# DESCARGA
# =========================================================
# DOWNLOAD_DIR: carpeta base de descargas (las muestras van en pending/).
# MAX_ATTACHMENT_SIZE_MB: tamano maximo por adjunto. Si se supera, se registra error.
# MAX_FILENAME_LENGTH: largo maximo del nombre visible (Subject) de los archivos.

DOWNLOAD_DIR=downloads
MAX_ATTACHMENT_SIZE_MB=100
MAX_FILENAME_LENGTH=150


# =========================================================
# CONVERSION
# =========================================================
# KEEP_ORIGINAL_MSG: SOLO INFORMATIVO. El .msg original es evidencia y NUNCA se
#                    borra, aunque pongas false. La cadena de custodia lo exige.
# CREATE_EML: generar el .eml derivado cuando sea tecnicamente posible.

KEEP_ORIGINAL_MSG=true
CREATE_EML=true


# =========================================================
# DATABASE
# =========================================================
# Ruta de la base SQLite local (estado y deduplicacion).

DATABASE_PATH=data/phishing_collector.db


# =========================================================
# LOG
# =========================================================
# LOG_LEVEL: INFO (normal) o DEBUG (mas detalle).
# LOG_DIR: carpeta de logs.

LOG_LEVEL=INFO
LOG_DIR=logs
